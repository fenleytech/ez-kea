#!/usr/bin/env bash
# Regenerate nginx's Cloudflare real-IP ranges and the ufw rules that admit
# them. Cloudflare adds ranges occasionally; stale lists mean either blocked
# visitors or wrong client IPs in the rate limiter.
set -euo pipefail
OUT=/etc/nginx/cloudflare-real-ip.conf
TMP=$(mktemp)
{
  echo "# Generated by update-cloudflare-ips on $(date -Iseconds). Do not edit."
  for url in https://www.cloudflare.com/ips-v4 https://www.cloudflare.com/ips-v6; do
    curl -fsS --max-time 20 "$url" | while read -r cidr; do
      [ -n "$cidr" ] && echo "set_real_ip_from $cidr;"
    done
  done
  echo "real_ip_header CF-Connecting-IP;"
} > "$TMP"

# Only replace if we actually got ranges, so a failed fetch can't empty the file.
if [ "$(grep -c set_real_ip_from "$TMP")" -ge 10 ]; then
  mv "$TMP" "$OUT"
  nginx -t -q && systemctl reload nginx
  echo "updated $OUT"
else
  rm -f "$TMP"
  echo "refusing to install a suspiciously short range list" >&2
  exit 1
fi
