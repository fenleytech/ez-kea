[Unit]
Description=Reset the EZ-KEA public demo every 30 minutes

[Timer]
# Also fires shortly after boot, so a host that was down over a reboot comes
# back up with a clean demo rather than whatever the last visitor left behind.
OnBootSec=2min
OnUnitActiveSec=30min
AccuracySec=1min
Persistent=true

[Install]
WantedBy=timers.target
