# .env.testbed
#
# Environment for running EZ-Kea locally against the Docker testbed under
# testbed/ (see testbed/README.md). Sourced by start_testbed.sh:
#
#   docker compose -f testbed/docker-compose.yml up -d
#   bash start_testbed.sh
#
# All file paths here are HOST paths (this is what EZ-Kea itself reads and
# writes) — they point at the same files the `kea` container has bind-mounted
# at testbed/data/{etc/kea,var/lib/kea,var/log}, per docker-compose.yml.

# --- Host-side file paths (what EZ-Kea itself reads/writes) -----------------
DHCP_CONFIG_FILE=./testbed/data/etc/kea/kea-dhcp4.conf
DHCP_LEASES_FILE=./testbed/data/var/lib/kea/kea-leases4.csv
DHCP_LOG_FILE=./testbed/data/var/log/kea-dhcp4.log
BACKUP_DIR=./testbed/data/backups/
SETTINGS_FILE=./testbed/data/ez-kea-settings.json

# --- Commands: exec into the running "kea-testbed-kea-1" container ----------
KEA_DHCP4_CMD="docker exec kea-testbed-kea-1 kea-dhcp4"
KEA_CTRL_CMD="docker exec kea-testbed-kea-1 keactrl"

# --- In-container paths (see AUDIT_FINDINGS.md 2.3) --------------------------
# The volume mount exposes the same files at DIFFERENT absolute paths inside
# the container's own filesystem namespace than the host paths above — these
# tell `docker exec ... kea-dhcp4 -t <path>` / Kea's own logger config which
# path to use instead of the (nonexistent, from the container's point of
# view) host path.
DHCP_CONFIG_FILE_IN_CONTAINER=/etc/kea/kea-dhcp4.conf
DHCP_LOG_FILE_IN_CONTAINER=/var/log/kea-dhcp4.log

# --- Reload strategy ----------------------------------------------------------
# The testbed's Kea image does not ship /etc/kea/keactrl.conf, so
# `keactrl reload` fails outright (see testbed/README.md). Use a container
# SIGHUP instead -- this is the one mechanism that actually works here.
KEA_RELOAD_STRATEGY=sighup
KEA_DOCKER_CONTAINER=kea-testbed-kea-1
